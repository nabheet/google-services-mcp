{
  "name": "google-services-mcp",
  "version": "0.1.0",
  "description": "Gmail MCP server for AI agents — Google Workspace MCP with 100+ tools for Gmail, Calendar, Drive, Docs, Sheets, Meet, and more, multi-account OAuth.",
  "type": "module",
  "main": "dist/main.js",
  "bin": {
    "google-services-mcp": "dist/main.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check . && markdownlint-cli2 \"**/*.md\" \"#node_modules/**\" \"#dist/**\" \"#.git/**\"",
    "lint:fix": "biome check --write . && markdownlint-cli2 --fix \"**/*.md\" \"#node_modules/**\" \"#dist/**\" \"#.git/**\"",
    "check": "npm run typecheck && npm run lint && npm test",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "mcp",
    "model context protocol",
    "google workspace",
    "gmail",
    "google calendar",
    "google drive",
    "google docs",
    "google sheets",
    "meet",
    "contacts",
    "tasks",
    "forms",
    "youtube",
    "oauth 2.0",
    "ai agent",
    "multi-account"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nabheet/google-services-mcp.git"
  },
  "homepage": "https://github.com/nabheet/google-services-mcp#readme",
  "bugs": {
    "url": "https://github.com/nabheet/google-services-mcp/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "googleapis": "^182.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^26.6.3",
    "markdownlint-cli2": "^0.23.3",
    "nock": "^14.0.17",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
